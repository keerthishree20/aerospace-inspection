# Needed for the chat assistant, and for inspections when models/best.pt is absent.
# Get one at https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Free OpenRouter models are withdrawn from time to time and are often
# rate-limited. This ordered list is tried in turn. Every model must accept
# images; find others at https://openrouter.ai/models
OPENROUTER_MODELS=qwen/qwen3.8-27b:free,inclusionai/ling-3.0-flash-vl:free,google/gemma-4-31b-it:free

DATABASE_URL=sqlite+aiosqlite:///./aerospace.db
